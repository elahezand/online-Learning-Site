    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.0",
    "tsx": "^4.19.2",
    "zod": "^4.1.13"
